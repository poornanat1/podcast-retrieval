# Copy to .env (gitignored); docker compose reads it automatically.
# Particle data platform key (https://docs.particle.pro) for podcast discovery.
PARTICLE_API_KEY=
# Podcasts discovered from the trending list per day (0 disables).
PODFIND_DAILY_TRENDING=25
# OpenAI key for relevance judging and LLM-written training queries.
OPENAI_API_KEY=
# ElevenLabs key for synthesizing the speech test set (paid plan; optional,
# the Chatterbox synthesizer needs no key).
ELEVENLABS_API_KEY=
# Object storage (S3 API). Unset, the Go services keep no raw artifacts or
# voice recordings; the compose stack's RustFS is at localhost:9000 with
# the keys below. A managed bucket takes a URL endpoint and its region.
OBJECT_STORE_ENDPOINT=localhost:9000
OBJECT_STORE_ACCESS_KEY=podfind
OBJECT_STORE_SECRET_KEY=podfind-dev-secret
OBJECT_STORE_BUCKET=recordings
#OBJECT_STORE_REGION=auto
