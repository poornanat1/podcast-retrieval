# Copy to .env (gitignored); docker compose reads it automatically.
# Particle data platform key (https://docs.particle.pro) for podcast discovery.
PARTICLE_API_KEY=
# Podcasts discovered from the trending list per day (0 disables).
PODFIND_DAILY_TRENDING=25
# OpenAI key for relevance judging and LLM-written training queries.
OPENAI_API_KEY=
# ElevenLabs key for synthesizing the speech test set (paid plan; optional,
# the Chatterbox synthesizer needs no key).
ELEVENLABS_API_KEY=
